# Ansible Lab 26 Inventory
# Managed nodes for role-based configuration management

[managed_nodes]
ivolve-node-1 ansible_host=192.168.1.10 ansible_user=vagrant
ivolve-node-2 ansible_host=192.168.1.11 ansible_user=vagrant
ivolve-node-3 ansible_host=192.168.1.12 ansible_user=vagrant

[all:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'